{
  "extends": "./tsconfig.base.json",
  "compileOnSave": false,
  "include": [
    "backend/**/*",
    "frontend/**/*",
    "shared/**/*"
  ],
  "references": [
    {
      "path": "./lib/db"
    },
    {
      "path": "./lib/api-client-react"
    },
    {
      "path": "./lib/api-zod"
    }
  ],
  "compilerOptions": {
    "paths": {
      "@shared/*": [
        "./shared/*"
      ],
      "@backend/*": [
        "./backend/*"
      ],
      "@/*": [
        "./frontend/src/*"
      ]
    }
  }
}